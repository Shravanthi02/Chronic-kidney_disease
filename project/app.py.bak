# PAGE: HOME
# ═════════════════════════════════════════════════════════════════════════════
if page == "🏠  Home":
    # Hero header
    st.markdown("""
    <div style='text-align:center; padding: 40px 0 20px;'>
        <div style='font-size:4rem; margin-bottom:8px;'>🫁</div>
        <h1 style='font-size:2.6rem; font-weight:800; background:linear-gradient(90deg,#63b3ed,#4fd1c7);
                   -webkit-background-clip:text; -webkit-text-fill-color:transparent; margin:0;'>
            Chronic Kidney Disease
        </h1>
        <h2 style='font-size:1.6rem; font-weight:400; color:#a0aec0; margin:4px 0 0;'>
            Risk Prediction System
        </h2>
        <div style='width:80px; height:3px; background:linear-gradient(90deg,#63b3ed,#4fd1c7);
                    margin:16px auto; border-radius:2px;'></div>
        <p style='color:#718096; max-width:640px; margin:0 auto; font-size:1rem; line-height:1.7;'>
            An AI-powered clinical decision support tool that analyses 35 biomarkers and
            patient characteristics to predict the stage of Chronic Kidney Disease with
            high accuracy.
        </p>
    </div>
    """, unsafe_allow_html=True)

    # Key stats
    col1, col2, col3, col4 = st.columns(4)
    stats = [
        ("35", "Clinical Features", "🔬"),
        ("5",  "CKD Stages",        "📋"),
        ("4",  "ML Models Trained", "🤖"),
        ("21K","Training Samples",  "📦"),
    ]
    for col, (val, label, icon) in zip([col1, col2, col3, col4], stats):
        with col:
            st.markdown(f"""
            <div class='metric-card'>
                <div style='font-size:1.8rem;'>{icon}</div>
                <div class='metric-value'>{val}</div>
                <div class='metric-label'>{label}</div>
            </div>""", unsafe_allow_html=True)

    st.markdown("<br>", unsafe_allow_html=True)

    # Model status banner
    if model_loaded:
        st.success(f"✅ Model loaded successfully — **{bundle['model_name']}**  |  "
                   f"Accuracy: **{bundle['metrics']['accuracy']*100:.1f}%**  |  "
                   f"F1-Score: **{bundle['metrics']['f1_score']*100:.1f}%**")
    else:
        st.warning("⚠️  Model not found. Please run `python train_model.py` first, then refresh.")

    st.markdown("<br>", unsafe_allow_html=True)

    # Feature overview
    col_a, col_b = st.columns(2)
    with col_a:
        st.markdown("<div class='section-header'>🔍 CKD Stages</div>", unsafe_allow_html=True)
        stages = [
            ("✅", "Healthy Kidney",          "#68d391", "Normal kidney function (eGFR ≥ 90)"),
            ("🟡", "Mild CKD (Stage 1–2)",    "#f6e05e", "Slightly reduced function (eGFR 60–89)"),
            ("🟠", "Moderate CKD (Stage 3)",  "#ed8936", "Moderately reduced (eGFR 30–59)"),
            ("🔴", "Severe CKD (Stage 4)",    "#fc8181", "Severely reduced (eGFR 15–29)"),
            ("🚨", "Kidney Failure (Stage 5)","#e53e3e",  "Kidney failure (eGFR < 15)"),
        ]
        for em, name, color, desc in stages:
            st.markdown(f"""
            <div style='display:flex; align-items:center; gap:12px; padding:10px 14px;
                        background:#1e2535; border-left:4px solid {color};
                        border-radius:8px; margin-bottom:8px;'>
                <span style='font-size:1.3rem;'>{em}</span>
                <div>
                    <div style='color:#e2e8f0; font-weight:600; font-size:0.9rem;'>{name}</div>
                    <div style='color:#718096; font-size:0.78rem;'>{desc}</div>
                </div>
            </div>""", unsafe_allow_html=True)

    with col_b:
        st.markdown("<div class='section-header'>⚙️ How It Works</div>", unsafe_allow_html=True)
        steps = [
            ("1", "Input Patient Data",   "Enter 35 clinical biomarkers and demographic details."),
            ("2", "Data Preprocessing",   "Automatic encoding, scaling, and normalisation."),
            ("3", "Model Inference",       "Best ML classifier predicts the CKD stage."),
            ("4", "Result & Confidence",  "Stage label, confidence score, and clinical advice."),
        ]
        for num, title, desc in steps:
            st.markdown(f"""
            <div style='display:flex; align-items:flex-start; gap:14px; padding:12px;
                        background:#1e2535; border-radius:10px; margin-bottom:8px;'>
                <div style='background:linear-gradient(135deg,#2b6cb0,#3182ce); color:white;
                            width:30px; height:30px; border-radius:50%; display:flex;
                            align-items:center; justify-content:center; font-weight:700;
                            flex-shrink:0;'>{num}</div>
                <div>
                    <div style='color:#e2e8f0; font-weight:600; font-size:0.9rem;'>{title}</div>
                    <div style='color:#718096; font-size:0.78rem; margin-top:2px;'>{desc}</div>
                </div>
            </div>""", unsafe_allow_html=True)


# ═════════════════════════════════════════════════════════════════════════════
# PAGE: PREDICTION
# ═════════════════════════════════════════════════════════════════════════════
elif page == "🔬  Prediction":
    st.markdown("<h1 style='color:#e2e8f0;'>🔬 CKD Stage Prediction</h1>", unsafe_allow_html=True)
    st.markdown("<p style='color:#a0aec0;'>Fill in the patient's clinical details below and press <b>Predict</b>.</p>",
                unsafe_allow_html=True)

    if not model_loaded:
        st.error("❌ Model not loaded. Run `python train_model.py` first.")
        st.stop()

    st.markdown("---")

    # ── Input form ────────────────────────────────────────────────────────────
    with st.form("prediction_form"):
        # ── Demographics & Vitals ──────────────────────────────────────────
        st.markdown("<div class='section-header'>👤 Demographics & Vital Signs</div>", unsafe_allow_html=True)
        c1, c2, c3, c4 = st.columns(4)
        age       = c1.number_input("Age (years)", 1, 120, 50, help="Patient age in years")
        gender    = c2.selectbox("Gender", ["Male (1)", "Female (0)"])
        bmi       = c3.number_input("BMI", 10.0, 60.0, 25.0, step=0.1)
        heart_rate= c4.number_input("Heart Rate (bpm)", 30, 200, 75)

        c1, c2, c3, c4 = st.columns(4)
        sys_bp    = c1.number_input("Systolic BP (mmHg)",  60, 220, 120)
        dia_bp    = c2.number_input("Diastolic BP (mmHg)", 40, 140, 80)

        st.markdown("<br>", unsafe_allow_html=True)

        # ── Kidney Function Markers ────────────────────────────────────────
        st.markdown("<div class='section-header'>🧪 Kidney Function Markers</div>", unsafe_allow_html=True)
        c1, c2, c3, c4 = st.columns(4)
        creatinine  = c1.number_input("Serum Creatinine (mg/dL)", 0.0, 20.0, 1.0, step=0.1)
        bun         = c2.number_input("Blood Urea Nitrogen (mg/dL)", 0, 200, 15)
        egfr        = c3.number_input("eGFR (mL/min/1.73m²)", 0, 200, 90)
        urine_alb   = c4.number_input("Urine Albumin (mg/L)", 0, 5000, 20)

        c1, c2, c3, c4 = st.columns(4)
        urine_prot  = c1.number_input("Urine Protein (mg/dL)", 0, 1000, 5)
        acr         = c2.number_input("Albumin-Creatinine Ratio", 0, 3000, 30)
        usg         = c3.number_input("Urine Specific Gravity", 1.000, 1.040, 1.015, step=0.001, format="%.3f")

        st.markdown("<br>", unsafe_allow_html=True)

        # ── Electrolytes ──────────────────────────────────────────────────
        st.markdown("<div class='section-header'>⚗️ Electrolytes & Minerals</div>", unsafe_allow_html=True)
        c1, c2, c3, c4 = st.columns(4)
        sodium   = c1.number_input("Sodium (mEq/L)",     100, 180, 140)
        potassium= c2.number_input("Potassium (mEq/L)",  2.0, 8.0, 4.0, step=0.1)
        calcium  = c3.number_input("Calcium (mg/dL)",    4.0, 14.0, 9.5, step=0.1)
        phosphorus=c4.number_input("Phosphorus (mg/dL)", 1.0, 12.0, 3.5, step=0.1)

        c1, c2 = st.columns(2)
        chloride    = c1.number_input("Chloride (mEq/L)",   80, 130, 102)
        bicarbonate = c2.number_input("Bicarbonate (mEq/L)",10, 40,  24)

        st.markdown("<br>", unsafe_allow_html=True)

        # ── Blood Panel ───────────────────────────────────────────────────
        st.markdown("<div class='section-header'>🩸 Blood Panel</div>", unsafe_allow_html=True)
        c1, c2, c3, c4 = st.columns(4)
        hemoglobin = c1.number_input("Hemoglobin (g/dL)",     4.0, 20.0, 14.0, step=0.1)
        rbc        = c2.number_input("RBC Count (×10⁶/µL)",  2.0, 8.0,  5.0,  step=0.1)
        wbc        = c3.number_input("WBC Count (/µL)",       1000, 30000, 7000, step=100)
        platelets  = c4.number_input("Platelet Count (/µL)",  50000, 800000, 250000, step=1000)

        c1, c2 = st.columns(2)
        pcv = c1.number_input("Packed Cell Volume (%)", 10, 60, 42)

        st.markdown("<br>", unsafe_allow_html=True)

        # ── Glucose & Lipids ──────────────────────────────────────────────
        st.markdown("<div class='section-header'>🍬 Glucose & Lipids</div>", unsafe_allow_html=True)
        c1, c2, c3, c4 = st.columns(4)
        bgr       = c1.number_input("Blood Glucose Random (mg/dL)", 50, 500, 100)
        fasting_g = c2.number_input("Fasting Glucose (mg/dL)",      60, 400, 90)
        hba1c     = c3.number_input("HbA1c (%)",                    3.0, 15.0, 5.5, step=0.1)
        cholesterol=c4.number_input("Cholesterol (mg/dL)",           80, 400, 180)

        c1, c2 = st.columns(2)
        triglycerides = c1.number_input("Triglycerides (mg/dL)", 30, 1000, 150)

        st.markdown("<br>", unsafe_allow_html=True)

        # ── Proteins ──────────────────────────────────────────────────────
        st.markdown("<div class='section-header'>🔬 Serum Proteins</div>", unsafe_allow_html=True)
        c1, c2 = st.columns(2)
        serum_albumin = c1.number_input("Serum Albumin (g/dL)",  1.0, 6.0, 4.0, step=0.1)
        total_protein = c2.number_input("Total Protein (g/dL)",  3.0, 10.0, 7.0, step=0.1)

        st.markdown("<br>", unsafe_allow_html=True)

        # ── Risk Factors ──────────────────────────────────────────────────
        st.markdown("<div class='section-header'>⚠️ Risk Factors</div>", unsafe_allow_html=True)
        c1, c2, c3, c4 = st.columns(4)
        diabetes    = c1.selectbox("Diabetes",              ["Yes", "No"])
        hypertension= c2.selectbox("Hypertension",          ["Yes", "No"])
        smoking     = c3.selectbox("Smoking Status",         ["Yes", "No"])
        family_hist = c4.selectbox("Family History Kidney",  ["Yes", "No"])

        st.markdown("<br>", unsafe_allow_html=True)
        submitted = st.form_submit_button("🔮 Predict CKD Stage", use_container_width=True)

    # ── Prediction ─────────────────────────────────────────────────────────
    if submitted:
        gender_val = 1 if "Male" in gender else 0

        input_dict = {
            "Age": age, "Gender": gender_val, "BMI": bmi,
            "Systolic_BP": sys_bp, "Diastolic_BP": dia_bp, "Heart_Rate": heart_rate,
            "Serum_Creatinine": creatinine, "Blood_Urea_Nitrogen": bun, "eGFR": egfr,
            "Urine_Albumin": urine_alb, "Urine_Protein": urine_prot,
            "Albumin_Creatinine_Ratio": acr, "Urine_Specific_Gravity": usg,
            "Sodium": sodium, "Potassium": potassium, "Calcium": calcium,
            "Phosphorus": phosphorus, "Chloride": chloride, "Bicarbonate": bicarbonate,
            "Hemoglobin": hemoglobin, "RBC_Count": rbc, "WBC_Count": wbc,
            "Platelet_Count": platelets, "Packed_Cell_Volume": pcv,
            "Blood_Glucose_Random": bgr, "Fasting_Glucose": fasting_g, "HbA1c": hba1c,
            "Cholesterol": cholesterol, "Triglycerides": triglycerides,
            "Serum_Albumin": serum_albumin, "Total_Protein": total_protein,
            "Diabetes": diabetes, "Hypertension": hypertension,
            "Smoking_Status": smoking, "Family_History_Kidney": family_hist,
        }

        try:
            input_df = preprocess_single_input(input_dict, bundle["encoders"], bundle["scaler"])
            label, proba = predict_single(input_df, bundle)
            emoji = stage_emoji(label)
            rec   = stage_recommendation(label)

            conf_text = ""
            if proba is not None:
                conf = proba.max() * 100
                conf_text = f"<div class='confidence'>Confidence: {conf:.1f}%</div>"

            st.markdown(f"""
            <div class='prediction-card'>
                <div class='stage-label'>Predicted CKD Stage</div>
                <div class='stage-value'>{emoji} {label}</div>
                {conf_text}
            </div>""", unsafe_allow_html=True)

            # Recommendation
            st.info(f"**Clinical Recommendation:** {rec}")

            # Probability breakdown
            if proba is not None:
                st.markdown("<br>", unsafe_allow_html=True)
                st.markdown("#### 📊 Prediction Confidence per Stage")
                classes = bundle["classes"]
                fig, ax = plt.subplots(figsize=(8, 3))
                fig.patch.set_facecolor("#1e2535")
                ax.set_facecolor("#1e2535")
                colors = [STAGE_COLORS.get(c, "#63b3ed") for c in classes]
                bars = ax.barh(classes, proba * 100, color=colors, height=0.5, edgecolor="none")
                ax.set_xlabel("Probability (%)", color="#a0aec0")
                ax.set_xlim(0, 100)
                ax.tick_params(colors="#a0aec0")
                for spine in ax.spines.values():
                    spine.set_visible(False)
                for bar, p in zip(bars, proba):
                    ax.text(bar.get_width() + 1, bar.get_y() + bar.get_height() / 2,
                            f"{p*100:.1f}%", va="center", color="#e2e8f0", fontsize=9)
                plt.tight_layout()
                st.pyplot(fig)
                plt.close(fig)

        except Exception as ex:
            st.error(f"❌ Prediction error: {ex}")


# ═════════════════════════════════════════════════════════════════════════════
# PAGE: ANALYTICS
# ═════════════════════════════════════════════════════════════════════════════
elif page == "📊  Analytics":
    st.markdown("<h1 style='color:#e2e8f0;'>📊 Analytics Dashboard</h1>", unsafe_allow_html=True)

    if train_df is None:
        st.error("Dataset not found. Ensure datasets are in the `dataset/` folder.")
        st.stop()

    # ── Model Metrics ─────────────────────────────────────────────────────
    st.markdown("<div class='section-header'>🏆 Best Model Performance</div>", unsafe_allow_html=True)

    if model_loaded:
        m = bundle["metrics"]
        c1, c2, c3, c4 = st.columns(4)
        for col, (k, label) in zip([c1, c2, c3, c4],
                                   [("accuracy","Accuracy"), ("precision","Precision"),
                                    ("recall","Recall"), ("f1_score","F1-Score")]):
            with col:
                st.markdown(f"""
                <div class='metric-card'>
                    <div class='metric-value'>{m[k]*100:.1f}%</div>
                    <div class='metric-label'>{label}</div>
                </div>""", unsafe_allow_html=True)

        st.markdown(f"<br><p style='color:#a0aec0; font-size:0.85rem;'>Model: <b style='color:#63b3ed;'>{bundle['model_name']}</b></p>",
                    unsafe_allow_html=True)

        # Model Comparison Table
        if "comparison_metrics" in bundle:
            st.markdown("<br>", unsafe_allow_html=True)
            st.markdown("#### 📋 All Models Comparison")
            comp = bundle["comparison_metrics"]
            comp_df = pd.DataFrame(comp).T.drop(columns=["time_s"], errors="ignore")
            comp_df.columns = ["Accuracy", "Precision", "Recall", "F1-Score"]
            comp_df = comp_df.map(lambda x: f"{x*100:.2f}%")
            st.dataframe(comp_df, use_container_width=True)

        # Comparison chart
        comp_img = os.path.join(ASSETS_DIR, "model_comparison.png")
        if os.path.exists(comp_img):
            st.image(comp_img, caption="Model Comparison", use_container_width=True)

    else:
        st.warning("⚠️  Run `python train_model.py` to see model metrics.")

    st.markdown("---")

    # ── Dataset Summary ───────────────────────────────────────────────────
    st.markdown("<div class='section-header'>📦 Dataset Summary</div>", unsafe_allow_html=True)
    c1, c2, c3, c4 = st.columns(4)
    c1.metric("Training Rows",    f"{train_df.shape[0]:,}")
    c2.metric("Testing Rows",     f"{test_df.shape[0]:,}")
    c3.metric("Features",         f"{train_df.shape[1] - 1}")
    c4.metric("Missing (Train)",  f"{train_df.isnull().sum().sum()}")

    with st.expander("📋 View Training Data Sample"):
        st.dataframe(train_df.head(10), use_container_width=True)

    with st.expander("📊 Descriptive Statistics"):
        st.dataframe(train_df.describe().T.style.format("{:.3f}"), use_container_width=True)

    st.markdown("---")

    # ── Class Distribution ────────────────────────────────────────────────
    st.markdown("<div class='section-header'>🎯 Class Distribution</div>", unsafe_allow_html=True)
    class_counts = train_df["Target"].value_counts()

    c1, c2 = st.columns(2)
    with c1:
        fig, ax = plt.subplots(figsize=(6, 4))
        fig.patch.set_facecolor("#1e2535")
        ax.set_facecolor("#1e2535")
        colors = [STAGE_COLORS.get(lbl, "#63b3ed") for lbl in class_counts.index]
        bars = ax.bar(range(len(class_counts)), class_counts.values, color=colors, edgecolor="none", width=0.6)
        ax.set_xticks(range(len(class_counts)))
        ax.set_xticklabels([lbl.replace(" (", "\n(") for lbl in class_counts.index],
                           rotation=0, ha="center", fontsize=8, color="#a0aec0")
        ax.set_ylabel("Count", color="#a0aec0")
        ax.set_title("Training Set – Class Distribution", color="#e2e8f0", fontsize=11, fontweight="bold")
        ax.tick_params(colors="#a0aec0")
        for spine in ax.spines.values():
            spine.set_visible(False)
        for bar, val in zip(bars, class_counts.values):
            ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 30,
                    f"{val:,}", ha="center", fontsize=9, color="#e2e8f0")
        plt.tight_layout()
        st.pyplot(fig)
        plt.close(fig)

    with c2:
        fig, ax = plt.subplots(figsize=(5, 4))
        fig.patch.set_facecolor("#1e2535")
        ax.set_facecolor("#1e2535")
        wedges, texts, autotexts = ax.pie(
            class_counts.values, labels=None,
            colors=colors, autopct="%1.1f%%",
            startangle=140, pctdistance=0.75,
        )
        for at in autotexts: at.set_color("white"); at.set_fontsize(9)
        ax.legend(wedges, class_counts.index, loc="center left",
                  bbox_to_anchor=(1, 0, 0.5, 1), fontsize=8,
                  facecolor="#1e2535", labelcolor="#a0aec0", framealpha=0)
        ax.set_title("Class Proportions", color="#e2e8f0", fontsize=11, fontweight="bold")
        plt.tight_layout()
        st.pyplot(fig)
        plt.close(fig)

    st.markdown("---")

    # ── Feature Distributions ─────────────────────────────────────────────
    st.markdown("<div class='section-header'>📈 Feature Distributions</div>", unsafe_allow_html=True)

    numeric_cols = train_df.select_dtypes(include=[np.number]).columns.tolist()
    numeric_cols = [c for c in numeric_cols if c != "Target"]

    selected_feat = st.selectbox("Select feature to inspect:", numeric_cols)
    c1, c2 = st.columns(2)

    with c1:
        fig, ax = plt.subplots(figsize=(6, 3.5))
        fig.patch.set_facecolor("#1e2535")
        ax.set_facecolor("#1e2535")
        ax.hist(train_df[selected_feat].dropna(), bins=40, color="#3182ce", edgecolor="#1e2535", alpha=0.85)
        ax.set_xlabel(selected_feat, color="#a0aec0")
        ax.set_ylabel("Frequency", color="#a0aec0")
        ax.set_title(f"Distribution of {selected_feat}", color="#e2e8f0", fontweight="bold")
        ax.tick_params(colors="#a0aec0")
        for spine in ax.spines.values(): spine.set_visible(False)
        plt.tight_layout()
        st.pyplot(fig)
        plt.close(fig)

    with c2:
        fig, ax = plt.subplots(figsize=(6, 3.5))
        fig.patch.set_facecolor("#1e2535")
        ax.set_facecolor("#1e2535")
        targets = train_df["Target"].unique()
        palette = [STAGE_COLORS.get(t, "#63b3ed") for t in sorted(targets)]
        for i, target in enumerate(sorted(targets)):
            subset = train_df[train_df["Target"] == target][selected_feat].dropna()
            ax.hist(subset, bins=30, alpha=0.65, label=target,
                    color=palette[i % len(palette)], edgecolor="none")
        ax.set_xlabel(selected_feat, color="#a0aec0")
        ax.set_ylabel("Frequency", color="#a0aec0")
        ax.set_title(f"{selected_feat} by CKD Stage", color="#e2e8f0", fontweight="bold")
        ax.legend(fontsize=7, facecolor="#1e2535", labelcolor="#a0aec0", framealpha=0)
        ax.tick_params(colors="#a0aec0")
        for spine in ax.spines.values(): spine.set_visible(False)
        plt.tight_layout()
        st.pyplot(fig)
        plt.close(fig)

    st.markdown("---")

    # ── Confusion Matrix ──────────────────────────────────────────────────
    if model_loaded:
        st.markdown("<div class='section-header'>🎯 Confusion Matrix</div>", unsafe_allow_html=True)
        cm_img = os.path.join(ASSETS_DIR, "confusion_matrix.png")
        if os.path.exists(cm_img):
            st.image(cm_img, use_container_width=False, width=600)
        elif "confusion_matrix" in bundle:
            cm_arr = bundle["confusion_matrix"]
            fig, ax = plt.subplots(figsize=(7, 5))
            fig.patch.set_facecolor("#1e2535")
            ax.set_facecolor("#1e2535")
            sns.heatmap(cm_arr, annot=True, fmt="d", cmap="Blues",
                        xticklabels=bundle["classes"], yticklabels=bundle["classes"], ax=ax)
            ax.set_xlabel("Predicted", color="#a0aec0")
            ax.set_ylabel("Actual", color="#a0aec0")
            ax.set_title("Confusion Matrix", color="#e2e8f0", fontweight="bold")
            ax.tick_params(colors="#a0aec0", labelsize=8)
            plt.tight_layout()
            st.pyplot(fig)
            plt.close(fig)

        if "classification_report" in bundle:
            with st.expander("📋 Full Classification Report"):
                st.code(bundle["classification_report"])



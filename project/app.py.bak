# ─────────────────────────────────────────────────────────────────────────────
# Load Resources (with graceful error handling)
# ─────────────────────────────────────────────────────────────────────────────
model_loaded = False
bundle       = None
train_df     = None
test_df      = None

try:
    bundle       = get_bundle()
    model_loaded = True
except FileNotFoundError as e:
    pass  # handled per-page

try:
    train_df, test_df = get_datasets()
except Exception as e:
    pass


